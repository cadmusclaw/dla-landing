//@version=6
// ═════════════════════════════════════════════════════════════════════════════
// TSE GAP30 — US30 Gap Detection (renamed from Trade Signal Engine [Gaps])
// -------------------------------------------------------------------------
// Builds each COMPLETED day's volume profile from a fixed 1-min feed (identical
// on every chart TF), detects LVN gaps, and STORES them per day. At each session
// start it selects the relevant prior day(s) — those whose range contains current
// price, with a walk-back fallback — and draws their gap lines, static for the
// session. No histogram.
//
// v1.1 — Non-24/7 market fix (US30):
//  • FIX: runtime crash "Index N is out of bounds" in the walk-back day
//    selection (Pine `for` loops count DOWNWARD when start > end). Guarded.
//  • NEW: optional fallback — if price gaps outside every stored day's range,
//    draw the most recent completed day's gaps instead of nothing.
//
// v1.2 — Transparency / diagnostics:
//  • NEW: source-day label on each gap line, "Drawn from" status row, and
//    optional debug rendering of the selected day's stored profile.
//
// v1.3 — Profile accuracy + interior gap detection:
//  • FIX: each 1-min bar's volume was binned entirely at its CLOSE price, so
//    fast moves punched artificial zero-volume holes and shifted gap zones.
//    Volume is now distributed across the bar's full high–low range, and the
//    day's range comes from true highs/lows instead of closes.
//  • CHANGE: detection now targets INTERIOR gaps between volume clusters.
//    Defaults: value-area gaps included (tail-only OFF), flanking HVN peaks
//    required on BOTH sides (prominence ON). The always-thin bins at the
//    day's range extremes no longer qualify as gaps.
//  • NEW: gap zones stored with their top/bottom bounds. "Gap line placement"
//    draws either both zone edges (default) or a single center line.
// ═════════════════════════════════════════════════════════════════════════════
indicator("TSE Gap30", shorttitle="TSE Gap30", overlay=true, max_lines_count=500, max_labels_count=200, max_boxes_count=500)

plot(na, title="dummy", display=display.none)

// ─── INPUTS ──────────────────────────────────────────────────────────────────

grpSes = "Session / Profile"
startHr  = input.int(18, "Session Start Hour", 0, 23, group=grpSes, tooltip="Hour the session begins, in the timezone below (24h). 18 = CME futures open.")
startMin = input.int(0,  "Session Start Minute", 0, 59, group=grpSes)
sesTz    = input.string("America/New_York", "Session Timezone", group=grpSes, tooltip="IANA name, e.g. America/New_York. DST handled automatically.")
profileRows = input.int(50, "Profile Rows (bins)", 20, 300, group=grpSes)
vaPct       = input.float(68, "Value Area %", 50, 90, 1, group=grpSes) / 100.0
ltfFeed     = input.timeframe("1", "Volume Feed Timeframe", group=grpSes, tooltip="Fixed feed the profile is built from, so gaps are identical on any chart TF.")

grpGap = "Gap Detection"
lvnPct     = input.float(30, "LVN zone threshold (% of POC)", 5, 60, 1, group=grpGap)
lvnMinBins = input.int(3, "Min LVN zone size (bins)", 2, 30, group=grpGap)
gapPct     = input.float(8, "Gap threshold (% of POC)", 1, 30, 1, group=grpGap)
gapMinBins = input.int(1, "Min gap size (bins)", 1, 15, group=grpGap)
tailOnly   = input.bool(false, "Only gaps outside the value area", group=grpGap, tooltip="ON = ignore low-volume zones inside the value area. OFF (default) = interior gaps between volume clusters are detected too.")
promEnable = input.bool(true, "Require flanking HVN peaks (prominence)", group=grpGap, tooltip="A gap must sit BETWEEN volume clusters. Filters out the always-thin bins at the day's range extremes.")
promBoth   = input.bool(true, "Require peaks on BOTH sides", group=grpGap)
promRatio  = input.float(2.0, "Prominence ratio (peak / valley)", 1.2, 6.0, 0.1, group=grpGap)

grpDay = "Day Selection"
daysConsider = input.int(3, "Recent days to consider", 1, 6, group=grpDay, tooltip="Draw gaps from days in this window whose range contains current price. If none contain it, walk further back to the most recent day that does.")
fallbackRecent = input.bool(true, "If no day contains price, draw most recent day", group=grpDay, tooltip="Non-24/7 markets (US30) often gap outside every stored day's range at the open. With this on, the most recent completed day's gaps are drawn anyway instead of nothing.")

grpDisp = "Display"
showGapLines = input.bool(true, "Show gap lines", group=grpDisp)
gapPlace     = input.string("Zone edges", "Gap line placement", options=["Zone edges", "Zone center"], group=grpDisp, tooltip="Zone edges = two lines bounding each gap zone. Zone center = one line at the middle.")
colGapLine   = input.color(#ff5030, "Gap line color", group=grpDisp)
gapStyleIn   = input.string("Solid", "Gap line style", options=["Solid", "Dashed", "Dotted"], group=grpDisp)
gapWidth     = input.int(2, "Gap line width", 1, 4, group=grpDisp)
showSrcLabels = input.bool(true, "Label each line with its source day", group=grpDisp)

grpDbg = "Status / Debug"
showStatus = input.bool(true, "Show status box", group=grpDbg, tooltip="Small panel reporting what the engine sees. Turn off for a clean chart.")
statusPos  = input.string("Bottom Right", "Status box position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grpDbg)
showDayProfile = input.bool(false, "Show source profile (debug)", group=grpDbg, tooltip="Draws the selected day's stored volume profile at the session start. Red bins = meet the gap threshold, orange = meet the LVN threshold, gray = normal volume.")
profWidth  = input.int(30, "Debug profile width (bars)", 10, 100, group=grpDbg)

// ─── CONSTANTS ───────────────────────────────────────────────────────────────

int MAXGAPS = 30      // max gaps stored/drawn per day
int MAXDAYS = 6       // completed days retained

gapStyle = gapStyleIn == "Dashed" ? line.style_dashed : gapStyleIn == "Dotted" ? line.style_dotted : line.style_solid

// ─── SESSION ANCHOR HELPER ───────────────────────────────────────────────────

sessAnchorOf(int t) =>
    aToday = timestamp(sesTz, year(t, sesTz), month(t, sesTz), dayofmonth(t, sesTz), startHr, startMin)
    tp     = t - 86400000
    aPrev  = timestamp(sesTz, year(tp, sesTz), month(tp, sesTz), dayofmonth(tp, sesTz), startHr, startMin)
    t >= aToday ? aToday : aPrev

// ─── STATE ───────────────────────────────────────────────────────────────────

var array<float> rawHi  = array.new_float()
var array<float> rawLo  = array.new_float()
var array<float> rawVol = array.new_float()
var int  curAnchor = na
var int  sStartBar = na
var bool skipFirst = true

// Per-day storage (newest at index 0). Gap zones keep their top/bottom bounds.
var matrix<float> dayGapLo = matrix.new<float>(0, MAXGAPS, na)
var matrix<float> dayGapHi = matrix.new<float>(0, MAXGAPS, na)
var matrix<float> dayBins  = matrix.new<float>(0, profileRows, 0.0)
var array<float>  dayHi   = array.new_float()
var array<float>  dayLo   = array.new_float()
var array<int>    dayCnt  = array.new_int()
var array<int>    dayAnchor = array.new_int()

var array<line>  drawnGapLines  = array.new_line()
var array<label> drawnGapLabels = array.new_label()
var array<box>   drawnProfBoxes = array.new_box()
var array<string> srcInfo = array.new_string(1, "none")   // which day(s) current lines came from

// Human tag for a stored day: the date its session ENDED (anchor + 24h).
dayTag(int d) =>
    str.format_time(array.get(dayAnchor, d) + 86400000, "MMM d", sesTz)

// ─── GAP DETECTION ───────────────────────────────────────────────────────────
// Returns the bottom/top price bounds of each gap zone in one finished profile.

detectGaps(array<float> bins, float pLo, float bStep, int pocI, int vLo, int vHi, float pocV) =>
    outLo = array.new_float()
    outHi = array.new_float()
    if pocV > 0
        lvnThr = lvnPct / 100.0
        gapThr = gapPct / 100.0
        zi = 0
        while zi < profileRows
            if array.get(bins, zi) / pocV <= lvnThr
                zj = zi
                while zj + 1 < profileRows and array.get(bins, zj + 1) / pocV <= lvnThr
                    zj += 1
                if (zj - zi + 1) >= lvnMinBins
                    gi = zi
                    while gi <= zj
                        if array.get(bins, gi) / pocV <= gapThr
                            gj = gi
                            while gj + 1 <= zj and array.get(bins, gj + 1) / pocV <= gapThr
                                gj += 1
                            if (gj - gi + 1) >= gapMinBins
                                outVA = gj < vLo or gi > vHi
                                pass = (not tailOnly) or outVA
                                if pass and promEnable
                                    valley = array.get(bins, gi)
                                    for k = gi to gj
                                        valley := math.min(valley, array.get(bins, k))
                                    peakL = 0.0
                                    if gi >= 1
                                        for k = 0 to gi - 1
                                            peakL := math.max(peakL, array.get(bins, k))
                                    peakR = 0.0
                                    if gj <= profileRows - 2
                                        for k = gj + 1 to profileRows - 1
                                            peakR := math.max(peakR, array.get(bins, k))
                                    okL = valley <= 0 ? peakL > 0 : peakL >= promRatio * valley
                                    okR = valley <= 0 ? peakR > 0 : peakR >= promRatio * valley
                                    pass := promBoth ? (okL and okR) : (gj < pocI ? okR : okL)
                                if pass and array.size(outLo) < MAXGAPS
                                    array.push(outLo, pLo + gi * bStep)
                                    array.push(outHi, pLo + (gj + 1) * bStep)
                            gi := gj + 1
                        else
                            gi += 1
                zi := zj + 1
            else
                zi += 1
    [outLo, outHi]

// ─── COMPUTE + STORE one completed day's profile/gaps (no drawing) ────────────

computeAndStoreGaps() =>
    n = array.size(rawVol)
    if n > 0
        pHi = array.max(rawHi)
        pLo = array.min(rawLo)
        bStep = (pHi - pLo) <= 0 ? syminfo.mintick : (pHi - pLo) / profileRows
        bins = array.new_float(profileRows, 0.0)
        // Distribute each feed bar's volume evenly across the bins its
        // high–low range covers (v1.3 fix: close-only binning punched
        // artificial holes in fast moves).
        for i = 0 to n - 1
            bh = array.get(rawHi, i)
            bl = array.get(rawLo, i)
            b0 = math.min(math.max(math.floor((bl - pLo) / bStep), 0), profileRows - 1)
            b1 = math.min(math.max(math.floor((bh - pLo) / bStep), 0), profileRows - 1)
            vPer = array.get(rawVol, i) / (b1 - b0 + 1)
            for b = b0 to b1
                array.set(bins, b, array.get(bins, b) + vPer)

        pocI = 0
        pocV = 0.0
        totV = 0.0
        for i = 0 to profileRows - 1
            vv = array.get(bins, i)
            totV += vv
            if vv > pocV
                pocV := vv
                pocI := i

        vLo = pocI
        vHi = pocI
        cv  = pocV
        while cv < vaPct * totV and (vLo > 0 or vHi < profileRows - 1)
            vRight = vHi < profileRows - 1 ? array.get(bins, vHi + 1) : na
            vLeft  = vLo > 0               ? array.get(bins, vLo - 1) : na
            if na(vRight) or (not na(vLeft) and vLeft >= nz(vRight, 0))
                cv += nz(vLeft, 0)
                vLo -= 1
            else if na(vLeft) or (not na(vRight) and vRight > vLeft)
                cv += nz(vRight, 0)
                vHi += 1
            else
                cv += nz(vRight, 0) + nz(vLeft, 0)
                vHi += 1
                vLo -= 1

        [gapsLo, gapsHi] = detectGaps(bins, pLo, bStep, pocI, vLo, vHi, pocV)
        cnt   = math.min(array.size(gapsLo), MAXGAPS)
        rowLo = array.new_float(MAXGAPS, na)
        rowHi = array.new_float(MAXGAPS, na)
        if cnt > 0
            for i = 0 to cnt - 1
                array.set(rowLo, i, array.get(gapsLo, i))
                array.set(rowHi, i, array.get(gapsHi, i))

        matrix.add_row(dayGapLo, 0, rowLo)
        matrix.add_row(dayGapHi, 0, rowHi)
        matrix.add_row(dayBins, 0, bins)
        array.unshift(dayHi, pHi)
        array.unshift(dayLo, pLo)
        array.unshift(dayCnt, cnt)
        array.unshift(dayAnchor, curAnchor)
        while array.size(dayHi) > MAXDAYS
            array.pop(dayHi)
            array.pop(dayLo)
            array.pop(dayCnt)
            array.pop(dayAnchor)
            matrix.remove_row(dayGapLo, matrix.rows(dayGapLo) - 1)
            matrix.remove_row(dayGapHi, matrix.rows(dayGapHi) - 1)
            matrix.remove_row(dayBins, matrix.rows(dayBins) - 1)
    true

// ─── DRAW one stored day's gaps as static, right-extended lines ──────────────

drawDayGaps(int d) =>
    cnt = array.get(dayCnt, d)
    if cnt > 0
        rLo = matrix.row(dayGapLo, d)
        rHi = matrix.row(dayGapHi, d)
        tag = dayTag(d)
        for i = 0 to cnt - 1
            zLo = array.get(rLo, i)
            zHi = array.get(rHi, i)
            if not na(zLo) and not na(zHi)
                if gapPlace == "Zone center"
                    mid = (zLo + zHi) / 2.0
                    array.push(drawnGapLines, line.new(bar_index, mid, bar_index + 1, mid, xloc.bar_index, extend.right, colGapLine, gapStyle, gapWidth))
                    if showSrcLabels
                        array.push(drawnGapLabels, label.new(bar_index, mid, tag, xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_none, textcolor=colGapLine, size=size.tiny))
                else
                    array.push(drawnGapLines, line.new(bar_index, zLo, bar_index + 1, zLo, xloc.bar_index, extend.right, colGapLine, gapStyle, gapWidth))
                    array.push(drawnGapLines, line.new(bar_index, zHi, bar_index + 1, zHi, xloc.bar_index, extend.right, colGapLine, gapStyle, gapWidth))
                    if showSrcLabels
                        array.push(drawnGapLabels, label.new(bar_index, zHi, tag, xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_none, textcolor=colGapLine, size=size.tiny))
    true

// ─── DRAW one stored day's profile at the session start (debug) ──────────────

drawDayProfile(int d) =>
    hi = array.get(dayHi, d)
    lo = array.get(dayLo, d)
    bStep = (hi - lo) <= 0 ? syminfo.mintick : (hi - lo) / profileRows
    rowB = matrix.row(dayBins, d)
    pocV = array.max(rowB)
    if pocV > 0
        for i = 0 to profileRows - 1
            v = array.get(rowB, i)
            w = math.max(1, math.round(profWidth * v / pocV))
            rel = v / pocV
            col = rel <= gapPct / 100.0 ? color.new(#ff5030, 45) : rel <= lvnPct / 100.0 ? color.new(#ffb020, 60) : color.new(#7a7a9a, 72)
            array.push(drawnProfBoxes, box.new(bar_index, lo + (i + 1) * bStep, bar_index + w, lo + i * bStep, border_color=color.new(color.black, 100), bgcolor=col))
    true

// ─── SELECT relevant day(s) for current price and (re)draw ───────────────────

drawDay(int d) =>
    drawDayGaps(d)
    if showDayProfile
        drawDayProfile(d)
    true

selectAndDrawGaps(float price) =>
    while array.size(drawnGapLines) > 0
        line.delete(array.pop(drawnGapLines))
    while array.size(drawnGapLabels) > 0
        label.delete(array.pop(drawnGapLabels))
    while array.size(drawnProfBoxes) > 0
        box.delete(array.pop(drawnProfBoxes))
    array.set(srcInfo, 0, "none")
    nStored = math.min(array.size(dayHi), array.size(dayLo), array.size(dayCnt), matrix.rows(dayGapLo))
    if showGapLines and nStored > 0
        drew  = false
        txt   = ""
        lastN = math.min(daysConsider, nStored)
        for d = 0 to lastN - 1
            if price <= array.get(dayHi, d) and price >= array.get(dayLo, d)
                drawDay(d)
                txt := txt == "" ? dayTag(d) : txt + ", " + dayTag(d)
                drew := true
        // Walk-back: only when older days actually exist. Pine `for` loops
        // count DOWNWARD when start > end, so an unguarded
        // `for d = lastN to nStored - 1` with lastN > nStored - 1 reads past
        // the end of the day arrays (runtime crash on non-24/7 symbols).
        if not drew and lastN <= nStored - 1
            for d = lastN to nStored - 1
                if price <= array.get(dayHi, d) and price >= array.get(dayLo, d)
                    drawDay(d)
                    txt := dayTag(d) + " (walk-back)"
                    drew := true
                    break
        // Non-24/7 fallback: price gapped outside every stored day's range
        // (common at US30 opens). Draw the most recent completed day anyway.
        if not drew and fallbackRecent
            drawDay(0)
            txt := dayTag(0) + " (FALLBACK)"
        array.set(srcInfo, 0, txt == "" ? "none" : txt)
    true

// ─── ACCUMULATE 1-min feed, detect session boundaries, store + draw ──────────

ltfH = request.security_lower_tf(syminfo.tickerid, ltfFeed, high)
ltfL = request.security_lower_tf(syminfo.tickerid, ltfFeed, low)
ltfV = request.security_lower_tf(syminfo.tickerid, ltfFeed, volume)
ltfT = request.security_lower_tf(syminfo.tickerid, ltfFeed, time)

nSub = array.size(ltfT)
if nSub > 0 and nSub == array.size(ltfH) and nSub == array.size(ltfL) and nSub == array.size(ltfV)
    saFirst = sessAnchorOf(array.get(ltfT, 0))
    saLast  = sessAnchorOf(array.get(ltfT, nSub - 1))
    if saFirst == saLast
        if na(curAnchor) or saFirst != curAnchor
            if not na(curAnchor) and not skipFirst
                computeAndStoreGaps()
            skipFirst := na(curAnchor) ? skipFirst : false
            array.clear(rawHi)
            array.clear(rawLo)
            array.clear(rawVol)
            curAnchor := saFirst
            sStartBar := bar_index
            selectAndDrawGaps(close)
        for i = 0 to nSub - 1
            array.push(rawHi,  array.get(ltfH, i))
            array.push(rawLo,  array.get(ltfL, i))
            array.push(rawVol, array.get(ltfV, i))
    else
        for i = 0 to nSub - 1
            sa = sessAnchorOf(array.get(ltfT, i))
            if na(curAnchor)
                curAnchor := sa
                sStartBar := bar_index
            else if sa != curAnchor
                if not skipFirst
                    computeAndStoreGaps()
                skipFirst := false
                array.clear(rawHi)
                array.clear(rawLo)
                array.clear(rawVol)
                curAnchor := sa
                sStartBar := bar_index
                selectAndDrawGaps(close)
            array.push(rawHi,  array.get(ltfH, i))
            array.push(rawLo,  array.get(ltfL, i))
            array.push(rawVol, array.get(ltfV, i))
else
    sa = sessAnchorOf(time)
    if na(curAnchor)
        curAnchor := sa
        sStartBar := bar_index
    else if sa != curAnchor
        if not skipFirst
            computeAndStoreGaps()
        skipFirst := false
        array.clear(rawHi)
        array.clear(rawLo)
        array.clear(rawVol)
        curAnchor := sa
        sStartBar := bar_index
        selectAndDrawGaps(close)
    array.push(rawHi,  high)
    array.push(rawLo,  low)
    array.push(rawVol, volume)

// ─── STATUS BOX (toggleable, corner-anchored) ────────────────────────────────

statusPosition = statusPos == "Top Right" ? position.top_right : statusPos == "Top Left" ? position.top_left : statusPos == "Bottom Left" ? position.bottom_left : statusPos == "Middle Right" ? position.middle_right : position.bottom_right

if barstate.islast and showStatus
    var table st = table.new(statusPosition, 2, 6, bgcolor=color.new(#1a1a2e, 10), border_width=1, border_color=#333355, frame_color=#444477, frame_width=1)
    nStored = array.size(dayHi)
    contains = "none"
    if nStored > 0
        for d = 0 to nStored - 1
            if close <= array.get(dayHi, d) and close >= array.get(dayLo, d)
                contains := dayTag(d)
                break
    table.cell(st, 0, 0, "TSE Gap30", text_color=#ff5030, text_size=size.small)
    table.cell(st, 1, 0, "", text_size=size.small)
    table.cell(st, 0, 1, "Stored days", text_color=#aaaacc, text_size=size.small)
    table.cell(st, 1, 1, str.tostring(nStored), text_color=#ffffff, text_size=size.small, text_halign=text.align_center)
    table.cell(st, 0, 2, "Price inside", text_color=#aaaacc, text_size=size.small)
    table.cell(st, 1, 2, contains, text_color=contains == "none" ? #ff1100 : #00ffbb, text_size=size.small, text_halign=text.align_center)
    table.cell(st, 0, 3, "Drawn from", text_color=#aaaacc, text_size=size.small)
    drawnFrom = array.get(srcInfo, 0)
    table.cell(st, 1, 3, drawnFrom, text_color=drawnFrom == "none" ? #ff1100 : #00ffbb, text_size=size.small, text_halign=text.align_center)
    table.cell(st, 0, 4, "Lines drawn", text_color=#aaaacc, text_size=size.small)
    table.cell(st, 1, 4, str.tostring(array.size(drawnGapLines)), text_color=#ffffff, text_size=size.small, text_halign=text.align_center)
    table.cell(st, 0, 5, "1-min feed", text_color=#aaaacc, text_size=size.small)
    table.cell(st, 1, 5, nSub > 0 ? "OK" : "no data", text_color=nSub > 0 ? #00ffbb : #ff1100, text_size=size.small, text_halign=text.align_center)
